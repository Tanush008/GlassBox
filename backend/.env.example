# Copy this file to .env and fill in your key.

GROQ_API_KEY=gsk_your-key-here
MODEL_NAME=openai/gpt-oss-20b
MAX_TOKENS_PER_CALL=2000

# Context engine token budget - lower this to see more aggressive
# compression, raise it to let more files through.
CONTEXT_TOKEN_BUDGET=1200

# How many coder<->reviewer rounds to allow before giving up and shipping
# the last diff anyway.
MAX_REVIEW_ITERATIONS=2

# Comma-separated list of origins allowed to hit the API / WebSocket.
ALLOWED_ORIGINS=http://localhost:3000
